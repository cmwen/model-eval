# promptfoo environment values
#
# Copy this file to .env if you want a local place to store API keys or proxy URLs.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...

# Optional local OpenAI-compatible endpoint for Ollama or another proxy.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional promptfoo defaults.
PROMPTFOO_DISABLE_CACHE=false
PROMPTFOO_CACHE_DIR=.promptfoo
