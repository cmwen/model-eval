# Environment Configuration for LLM Evaluation Framework
# Copy this file to .env and fill in your values

# ============================================================================
# Ollama Configuration (Primary - for local models)
# ============================================================================
# Base URL for Ollama API (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# LiteLLM Configuration (Optional - for unified API proxy)
# ============================================================================
# If using LiteLLM proxy for routing multiple providers
# LITELLM_API_BASE=http://localhost:8000

# ============================================================================
# Cloud Provider API Keys (Optional - only if testing cloud models)
# ============================================================================

# OpenAI (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-...

# Anthropic/Claude (https://console.anthropic.com/settings/keys)
# ANTHROPIC_API_KEY=sk-ant-...

# Google/Gemini (https://makersuite.google.com/app/apikey)
# GOOGLE_API_KEY=...

# Azure OpenAI (optional)
# AZURE_OPENAI_API_KEY=your-azure-openai-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# ============================================================================
# Custom AI Proxy Configuration (Optional)
# ============================================================================
# If using a custom AI proxy/gateway
# AI_PROXY_URL=http://your-proxy:8000
# AI_PROXY_API_KEY=your-key-here

# ============================================================================
# Evaluation Settings (Optional)
# ============================================================================
# Default model to use if not specified
DEFAULT_MODEL=ollama/gpt-oss:20b

# Output directory for results
RESULTS_DIR=results

# Enable debug logging
# DEBUG=false

# Temperature for model inference (0.0 = deterministic, 1.0 = creative)
DEFAULT_TEMPERATURE=0.0

# ============================================================================
# Azure AI Evaluation (Optional - for advanced metrics)
# ============================================================================
# AZURE_SUBSCRIPTION_ID=your-subscription-id
# AZURE_RESOURCE_GROUP=your-resource-group
# AZURE_PROJECT_NAME=your-project-name
